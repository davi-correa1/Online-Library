<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome - OLibrary</title>
    <link rel="stylesheet" href="./css/root.css">
</head>
<body>

    <div class="siteName">
        <h1>OLibrary</h1>
    </div>

    <div class="form">
        <div class="log">
            <h3>Log In</h3>
            <input class="user" type="text" placeholder="Username">
            <input class="pssw" type="password" placeholder="Password">
            <button class="btnLog">Log In</button>
        </div>

        <div class="sign">
            <h3>Sign Up</h3>
            <input class="newUser" type="text" placeholder="Username">
            <input class="newPssw" type="password" placeholder="Password">
            <button class="btnSign">Sign Up</button>
        </div>
    </div>
</body>
</html>