<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DarkLibrary - Sua Biblioteca Online</title>
    <link rel="stylesheet" href="/css/root.css">
</head>
<body>

    <header class="navbar">
        <h1>📚 </h1>
        <div class="search-box">
            <input type="text" placeholder="Pesquisar por título, autor ou gênero...">
            <button class="btn">Buscar</button>
        </div>
        <div>
            <button class="btn" style="background: transparent; border: 1px solid var(--borda);">Meu Perfil</button>
        </div>
    </header>

    <main class="container">
        <h2>Catálogo de Livros</h2>
        
        <div>
                <article class="livro-card">
                    <div class="capa-placeholder">📖OLibrary</div>
                    
                    <div class="livro-info">
                        
                    </div>
                </article>
        </div>
    </main>

</body>
</html>